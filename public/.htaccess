# ============================================================
#  .htaccess — SPA (TanStack Start static build) + PHP APIde
# ============================================================
# Place this file at the web root (same folder as index.html).
# Works on Apache 2.4+ with mod_rewrite, mod_headers, mod_deflate.
# ============================================================

# ------------------------------------------------------------
# 1) Security: block access to sensitive files
# ------------------------------------------------------------

# Block direct access to config.php (and any *.config.php / config.*.php)
<FilesMatch "(^|/)config(\..+)?\.php$|(^|/)\.env|(^|/)\.htaccess$|(^|/)\.htpasswd$|(^|/)composer\.(json|lock)$|(^|/)package(-lock)?\.json$|\.(sql|sqlite|db|log|ini|bak|backup|old|swp|dist|example)$">
    Require all denied
</FilesMatch>

# Block any file starting with a dot (.env, .git, etc.)
RewriteEngine On
RewriteRule (^|/)\.(?!well-known) - [F,L]

# Block access to common sensitive directories
RedirectMatch 403 (?i)/(\.git|\.svn|node_modules|vendor|tests?|storage/logs)(/|$)

# Disable directory listing
Options -Indexes

# Prevent PHP execution in upload/asset folders (adjust as needed)
<Directory "uploads">
    php_flag engine off
    <FilesMatch "\.(php|phtml|phps|php3|php4|php5|php7|php8|pl|py|jsp|asp|sh|cgi)$">
        Require all denied
    </FilesMatch>
</Directory>

# ------------------------------------------------------------
# 2) Security headers
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Remove server signature
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>
ServerSignature Off

# ------------------------------------------------------------
# 3) Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------
# 4) Cache static assets aggressively (hashed by Vite)
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 5) SPA fallback — serve index.html for all unknown routes
#    BUT keep PHP APIs and real files working.
# ------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Allow real files and directories (PHP scripts, assets, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Let PHP files run normally (api/foo.php, /endpoint.php, etc.)
RewriteRule \.php($|/) - [L]

# Anything under /api/ goes through (in case of pretty URLs handled by PHP)
# Comment this out if you don't have an /api folder
RewriteRule ^api(/|$) - [L]

# Everything else → index.html (SPA routing)
RewriteRule ^ index.html [L]

# ------------------------------------------------------------
# 6) MIME types (in case server doesn't know them)
# ------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>
